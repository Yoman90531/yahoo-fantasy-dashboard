YAHOO_CLIENT_ID=your_client_id
YAHOO_CLIENT_SECRET=your_client_secret
LEAGUE_ID=your_current_league_id
# First season year your league ran (e.g. 2014)
LEAGUE_START_YEAR=2014
DATABASE_URL=sqlite:///../data/fantasy.db
# Optional off-site backup (standard AWS credentials are read automatically)
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=fantasy-dashboard
BACKUP_S3_ENDPOINT_URL=
